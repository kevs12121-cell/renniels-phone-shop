# ---- Database (local MySQL). On Railway set DATABASE_URL=${{MySQL.MYSQL_URL}} instead.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rennielsPhoneShop
DB_USER=root
DB_PASSWORD=your_mysql_password
# DATABASE_URL=mysql://user:password@host:3306/database

# ---- API
PORT=5007
CLIENT_URL=http://localhost:5181
CLIENT_URLS=http://localhost:5181,http://192.168.8.134:5181
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
# Shop timezone used for "today", invoice numbers and reports
APP_TIMEZONE=+08:00

# ---- First-run accounts (created only when they do not exist yet)
OWNER_NAME=Renniels Owner
OWNER_EMAIL=owner@renniels.local
OWNER_PASSWORD=choose_a_strong_owner_password
CASHIER_PASSWORD=choose_a_strong_cashier_password

# Load ~90 days of realistic demo data when the product catalog is empty (true/false)
SEED_DEMO_DATA=true
